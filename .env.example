# Copy to .env.local (dev) or set in your host's environment (build time).
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.in
# Digits only, country code first, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# With +, e.g. +919876543210
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_MAPS_URL=
# Optional: Google Business Profile place ID (enables the "Write a review" link)
NEXT_PUBLIC_GOOGLE_PLACE_ID=
# Optional: your Google reviews/Maps share link (overrides the default search link)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
# Server-side only (never NEXT_PUBLIC_): Google Places API (New) key, read at build time to pull reviews
GOOGLE_PLACES_API_KEY=
